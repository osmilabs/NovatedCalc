# Public address of the site, e.g. https://example.com.au. Used for canonical links, the sitemap and
# structured data. Required in production; falls back to http://localhost:3000.
SITE_URL=

POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me

# Umami analytics (optional). Leave blank to turn analytics off.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
# Comma-separated hostnames to track, so local and preview visits don't count, e.g. novatedscout.com.au
UMAMI_DOMAINS=

# Google AdSense (optional). Leave the client blank to turn ads off; dev then shows placeholders.
# Client looks like ca-pub-1234567890123456. Each slot is an ad unit ID from AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE=
